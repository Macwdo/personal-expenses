# Copy this file to .env (or run `make env-init`) and keep it local.
# The generated namespace isolates Compose resources and Portless aliases.
COMPOSE_PROJECT_NAME=pingou-local
BIND_HOST=127.0.0.1

# Source checkouts. Absolute paths can select child-repository worktrees.
BACKEND_PATH=./pingou-o-que-backend
FRONTEND_PATH=./pingou-o-que-frontend
LANDING_PATH=./pingou-o-que-landing-page
CHAT_PATH=./pingou-o-que-chat

# Portless exposes stable URLs while Docker chooses collision-free host ports.
PORTLESS_NAMESPACE=pingou-local
PORTLESS_PROXY_PORT=1355
PORTLESS_TLD=localhost
FRONTEND_HOST=frontend.pingou-local.localhost
LANDING_HOST=landing.pingou-local.localhost
FRONTEND_URL=http://frontend.pingou-local.localhost:1355
LANDING_URL=http://landing.pingou-local.localhost:1355
PUBLIC_BACKEND_URL=http://api.pingou-local.localhost:1355
PUBLIC_CHAT_URL=http://chat.pingou-local.localhost:1355

# Django development settings.
SECRET_KEY=dev-only-change-me
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,api,api.pingou-local.localhost
CORS_ALLOWED_ORIGINS=http://frontend.pingou-local.localhost:1355,http://landing.pingou-local.localhost:1355
CSRF_TRUSTED_ORIGINS=http://frontend.pingou-local.localhost:1355,http://landing.pingou-local.localhost:1355

# Each Compose project gets its own PostgreSQL volume. Internal addresses use
# Docker DNS and are intentionally not exposed directly on the host.
POSTGRES_DB=pingou
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=
DATABASE_SSL_REQUIRE=0
TEST_DATABASE_DB=test_pingou

# Redis is both Celery's broker/result backend and the chat event bus.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_WORKER_CONCURRENCY=2

# AI/chat. Add the key required by AI_CHAT_MODEL before exercising the chat.
AI_CHAT_MODEL=openai:gpt-4o-mini
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
CHAT_STREAM_TTL_SECONDS=300
CHAT_STREAM_MODE=token

# Go chat logs and optional Next.js polling fallback.
CHAT_LOG_FORMAT=console
CHAT_LOG_LEVEL=info
WATCHPACK_POLLING=false

# Optional Flower authentication, e.g. admin:change-me.
FLOWER_BASIC_AUTH=
